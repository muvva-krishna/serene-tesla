  "suggestions": [
    {
      "id": "patch-02-tool_thrash_loop",
      "kind": "GUARDRAIL_PROCESSOR_PATCH",
      "priority": "P0",
      "targetPrimitive": "agent.processors",
      "triggerSignature": "TOOL_THRASH_LOOP",
      "title": "Add consecutive-identical tool-call circuit breaker processor",
      "rationale": "Agents repeated identical failing tool invocations >=3 times without changing arguments or refreshing state.",
      "patchSpec": {
        "processor": "ToolLoopCircuitBreaker",
        "maxConsecutiveIdenticalCalls": 2,
        "onTrip": "inject_error_recovery_hint_or_abort"
      },
      "supportingTraceIds": [
        "trace-mcp-stale-02"
      ],
      "estimatedPassRateGain": 0.2
    },
    {
      "id": "patch-03-stale_ref_desync",
      "kind": "PROMPT_INSTRUCTION_PATCH",
      "priority": "P0",
      "targetPrimitive": "agent.instructions",
      "triggerSignature": "STALE_REF_DESYNC",
      "title": "Enforce post-settle accessibility ref refresh after UI mutations",
      "rationale": "Traces show agents reusing invalidated @eN refs after press/fill --settle mutations. Updating instructions and returning activeRefs in MCP tool results eliminates STALE_REF retries.",
      "patchSpec": {
        "instructionAppend": "After any press/fill with settle=true, discard prior @eN refs and select targets exclusively from the returned diffLines/activeRefs or take a fresh snapshot(interactiveOnly=true).",
        "mcpToolReturnActiveRefs": true
      },
      "supportingTraceIds": [
        "trace-mcp-stale-02"
      ],
      "estimatedPassRateGain": 0.25
    },
    {
      "id": "patch-04-specification_gaming",
      "kind": "GUARDRAIL_PROCESSOR_PATCH",
      "priority": "P0",
      "targetPrimitive": "agent.processors",
      "triggerSignature": "SPECIFICATION_GAMING",
      "title": "Require unpatched verification tool pass before emitting final completion",
      "rationale": "Trajectory integrity checks flagged completion claims while required verification tools failed, were skipped, or test fixtures were modified.",
      "patchSpec": {
        "processor": "VerificationGateProcessor",
        "disallowTestFixtureWrites": true,
        "requirePassingVerificationTool": true
      },
      "supportingTraceIds": [
        "trace-code-hack-02"
      ],
      "estimatedPassRateGain": 0.25
    },
    {
      "id": "patch-01-cascade_tool_failure",
      "kind": "TOOL_SCHEMA_OR_DESCRIPTION_PATCH",
      "priority": "P1",
      "targetPrimitive": "mcp.tool",
      "triggerSignature": "CASCADE_TOOL_FAILURE",
      "title": "Enrich MCP/tool error payloads with structured recovery hints",
      "rationale": "Unrecovered tool failures lacked actionable recovery metadata (e.g., refreshed activeRefs or missing required params).",
      "patchSpec": {
        "includeRecoveryHintInToolError": true,
        "validateInputsWithZodBeforeDispatch": true
      },
      "supportingTraceIds": [
        "trace-mcp-stale-02"
      ],
      "estimatedPassRateGain": 0.15
    },
    {
      "id": "patch-05-memory_stale_or_miss",
